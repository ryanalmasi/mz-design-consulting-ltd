---
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import PageHeader from '@/components/PageHeader.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import CtaBand from '@/components/CtaBand.astro';
import { PROJECT_CATEGORIES } from '@/content.config';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

// Only offer a filter for categories that actually have projects in them. The
// old site rendered four filter tabs regardless, none of which did anything.
const categories = PROJECT_CATEGORIES.filter((c) =>
  projects.some((p) => p.data.category === c)
).map((c) => ({ name: c, count: projects.filter((p) => p.data.category === c).length }));
---

<Base
  title="Projects"
  description="Civil engineering projects delivered across Alberta and British Columbia — industrial earthworks, municipal stormwater systems, highway design, and commercial site development."
>
  <PageHeader
    title="Projects"
    lead="Representative work across industrial, commercial, municipal and infrastructure sectors in Alberta and British Columbia."
  />

  <section class="section">
    <div class="container">
      <div class="filter-bar">
        <h2 class="filter-label" id="filter-label">Filter by sector</h2>
        <div class="filters" role="group" aria-labelledby="filter-label">
          <button type="button" class="filter is-active" data-filter="all" aria-pressed="true">
            All <span class="filter-count data-sm">{projects.length}</span>
          </button>
          {
            categories.map((c) => (
              <button type="button" class="filter" data-filter={c.name} aria-pressed="false">
                {c.name} <span class="filter-count data-sm">{c.count}</span>
              </button>
            ))
          }
        </div>
      </div>

      <!-- Announces the result of filtering to screen readers, which a purely
           visual filter never does. -->
      <p class="filter-status visually-hidden" role="status" aria-live="polite" id="filter-status">
        Showing all {projects.length} projects
      </p>

      <div class="card-grid reveal" id="project-grid">
        {projects.map((p, i) => <ProjectCard project={p} priority={i < 2} />)}
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .filter-bar {
    display: flex;
    align-items: baseline;
    gap: var(--s-5);
    flex-wrap: wrap;
    padding-bottom: var(--s-4);
    border-bottom: var(--border-strong);
  }

  .filter-label {
    font-family: var(--font-mono);
    font-size: var(--t-2xs);
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .filters {
    display: flex;
    gap: var(--s-2);
    flex-wrap: wrap;
    margin-left: auto;
  }

  .filter {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: 44px;
    padding: var(--s-2) var(--s-4);
    border: var(--border);
    border-radius: var(--radius);
    background: var(--bg-raised);
    color: var(--text-muted);
    font-size: var(--t-sm);
    font-weight: 500;
    transition:
      color var(--dur) var(--ease),
      border-color var(--dur) var(--ease),
      background-color var(--dur) var(--ease);
  }

  .filter:hover {
    color: var(--text);
    border-color: var(--line-strong);
  }

  /* The pressed state is carried by background AND border, not colour alone.
     Using the text/background tokens rather than a fixed dark means it
     inverts correctly — a hard-coded --ink chip is nearly invisible against
     the dark-mode page ground. */
  .filter.is-active {
    background: var(--text);
    border-color: var(--text);
    color: var(--bg);
  }

  .filter-count {
    opacity: 0.6;
  }

  .filter.is-active .filter-count {
    color: var(--bg);
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--s-5);
    margin-top: var(--s-6);
  }

  .card-grid :global(.project-card.is-hidden) {
    display: none;
  }

  @media (max-width: 620px) {
    .filters {
      margin-left: 0;
      width: 100%;
    }
  }
</style>

<script>
  const grid = document.getElementById('project-grid');
  const status = document.getElementById('filter-status');
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('.filter'));

  if (grid && status && buttons.length) {
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('.project-card'));

    const apply = (filter: string) => {
      let shown = 0;

      for (const card of cards) {
        const match = filter === 'all' || card.dataset.category === filter;
        card.classList.toggle('is-hidden', !match);
        if (match) shown += 1;
      }

      for (const b of buttons) {
        const active = b.dataset.filter === filter;
        b.classList.toggle('is-active', active);
        b.setAttribute('aria-pressed', String(active));
      }

      status.textContent =
        filter === 'all'
          ? `Showing all ${shown} projects`
          : `Showing ${shown} ${filter.toLowerCase()} ${shown === 1 ? 'project' : 'projects'}`;

      // Keep the filter shareable and survive a back navigation.
      const url = new URL(window.location.href);
      if (filter === 'all') url.searchParams.delete('sector');
      else url.searchParams.set('sector', filter);
      history.replaceState(null, '', url);
    };

    for (const b of buttons) {
      b.addEventListener('click', () => apply(b.dataset.filter ?? 'all'));
    }

    const initial = new URL(window.location.href).searchParams.get('sector');
    if (initial && buttons.some((b) => b.dataset.filter === initial)) apply(initial);
  }
</script>
