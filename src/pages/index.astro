---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import SectionDiagram from '@/components/SectionDiagram.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import CtaBand from '@/components/CtaBand.astro';
import heroPoster from '@/assets/images/hero-earthworks-poster.jpg';
import { site, stats, software } from '@/site.config';

const projects = (await getCollection('projects'))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const articles = (await getCollection('insights'))
  .filter((a) => !a.data.draft)
  .sort((a, b) => b.data.published.getTime() - a.data.published.getTime())
  .slice(0, 3);

const services = [
  {
    id: 'grading',
    title: 'Site grading & earthworks',
    body: 'Mass grading, cut/fill optimization and mass haul planning, designed to balance on site instead of importing fill.',
  },
  {
    id: 'stormwater',
    title: 'Stormwater management',
    body: 'Hydrologic and hydraulic analysis, detention pond design, outlet structures, and erosion and sediment control.',
  },
  {
    id: 'transportation',
    title: 'Road & access design',
    body: 'Road geometry, intersections and industrial access designed for the vehicles that will actually use them.',
  },
  {
    id: 'industrial',
    title: 'Industrial site development',
    body: 'Facility grading, secondary containment, process drainage and utility coordination, resolved as one system.',
  },
  {
    id: 'municipal',
    title: 'Municipal infrastructure',
    body: 'Subdivision servicing, municipal roads, water and sewer, and the approval coordination that goes with them.',
  },
  {
    id: 'civil3d',
    title: 'Civil 3D & construction support',
    body: 'Surface and corridor modelling, quantity calculations, IFC drawing production, RFI responses and as-builts.',
  },
];
---

<Base
  title={`${site.name} | Civil engineering in Alberta & British Columbia`}
  description={site.description}
>
  <!-- ============ HERO ============ -->
  <section class="hero band-ink">
    <!-- Decorative background; the hero's actual content (title, lead, CTAs,
         diagram, caption) carries all of the meaning, so this is hidden from
         assistive tech rather than described. Sourced from Pexels ("A Drone
         Shot Over a Construction Site" by Jozef Papp, free commercial
         license, no attribution required), trimmed and re-encoded locally —
         see MEMORY.md for the licensing/attribution note and the reasoning
         behind the scrim strength below. -->
    <div class="hero-media" aria-hidden="true">
      <video
        class="hero-media-video"
        autoplay
        muted
        loop
        playsinline
        poster={heroPoster.src}
      >
        <source src="/video/hero-earthworks.webm" type="video/webm" />
        <source src="/video/hero-earthworks.mp4" type="video/mp4" />
      </video>
      <Image class="hero-media-poster" src={heroPoster} alt="" width={1920} height={1080} />
    </div>

    <div class="container hero-body">
      <h1 class="hero-title">
        Grading and drainage design<br />that balances on site
      </h1>
      <p class="hero-lead">
        We are civil engineers working across Alberta and British Columbia on land development,
        industrial facilities and municipal infrastructure — from the first terrain model through
        IFC drawings and construction support.
      </p>
      <div class="hero-actions">
        <a href="/contact" class="btn btn-primary">Start a project</a>
        <a href="/projects" class="btn btn-on-ink">See the work</a>
      </div>
    </div>

    <SectionDiagram class="hero-diagram" />

    <!-- The caption does the job a decorative diagram cannot: it states, in
         text, what the drawing above is showing. -->
    <div class="container">
      <p class="hero-caption">
        <span class="hero-caption-mark" aria-hidden="true"></span>
        Cut balanced against fill. When the volumes match, nothing gets trucked in and nothing
        gets trucked out — which on a large site is the biggest number on the earthworks bill.
      </p>
    </div>
  </section>

  <div class="container">
    <hr class="chainage" data-decorative="true" aria-hidden="true" />
  </div>

  <!-- ============ CREDENTIAL STRIP ============ -->
  <section class="proof band-paper">
    <div class="container">
      <dl class="proof-grid">
        <div class="proof-item">
          <dt>Years of experience</dt>
          <dd class="data">
            <span class="visually-hidden">{stats.yearsExperience}+</span>
            <span class="stat-visual" aria-hidden="true">
              <span class="stat-count" style={`--count-target:${stats.yearsExperience}`} />+
            </span>
          </dd>
        </div>
        <div class="proof-item">
          <dt>Projects delivered</dt>
          <dd class="data">
            <span class="visually-hidden">{stats.projectsDelivered}+</span>
            <span class="stat-visual" aria-hidden="true">
              <span class="stat-count" style={`--count-target:${stats.projectsDelivered}`} />+
            </span>
          </dd>
        </div>
        <div class="proof-item">
          <dt>Provinces served</dt>
          <dd class="data">AB &amp; BC</dd>
        </div>
        <div class="proof-item">
          <dt>Design platform</dt>
          <dd class="data">Civil 3D</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- ============ SERVICES ============ -->
  <section class="section" id="services">
    <div class="container">
      <div class="head reveal">
        <h2>What we do</h2>
        <a href="/services" class="link">All services</a>
      </div>
      <hr class="rule" />

      <ul class="svc-grid reveal">
        {
          services.map((s) => (
            <li class="svc">
              <h3><a href={`/services#${s.id}`}>{s.title}</a></h3>
              <p>{s.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ============ POSITION ============ -->
  <section class="section band-inset sheet-grid">
    <div class="container position">
      <div class="position-text reveal">
        <h2>Designs that survive contact with the site</h2>
        <div class="stack prose-measure">
          <p>
            Most of what goes wrong on a civil project goes wrong because the design assumed
            something the site did not agree with — a survey that missed a grade break, a utility
            at a different depth than the record showed, a minimum-gradient surface with no
            tolerance left in it for construction variation.
          </p>
          <p>
            We design for the conditions crews will actually encounter. That means checking flow
            paths on the design surface rather than trusting the arrows, confirming the elevations
            that cannot move before committing to a grading concept, and stating the assumptions
            behind every quantity we issue.
          </p>
          <p>
            It also means telling you early when a constraint makes something more expensive than
            you were told, instead of at the tender.
          </p>
        </div>
        <a href="/about" class="link position-link">How we work</a>
      </div>

      <div class="position-aside">
        <h3 class="position-aside-title">Software</h3>
        <hr class="rule" />
        <ul class="tool-list">
          {software.map((t) => <li class="data-sm">{t}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- ============ PROJECTS ============ -->
  <section class="section">
    <div class="container">
      <p class="match-line data-sm" data-decorative="true" aria-hidden="true">
        <span>SELECTED WORK</span>
      </p>
      <div class="head reveal">
        <h2>Selected projects</h2>
        <a href="/projects" class="link">All projects</a>
      </div>
      <hr class="rule" />

      <div class="card-grid reveal">
        {projects.map((p, i) => <ProjectCard project={p} priority={i === 0} />)}
      </div>
    </div>
  </section>

  <!-- ============ INSIGHTS ============ -->
  <section class="section band-inset sheet-grid">
    <div class="container">
      <div class="head reveal">
        <h2>Engineering notes</h2>
        <a href="/insights" class="link">All articles</a>
      </div>
      <hr class="rule" />

      <div class="card-grid reveal">
        {articles.map((a) => <ArticleCard article={a} />)}
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  /* ---- Hero ---- */
  .hero {
    position: relative;
    padding-top: var(--s-9);
    overflow: hidden;
  }

  /*
   * The video sits absolutely positioned behind everything else in .hero.
   * CSS paints positioned elements after non-positioned ones regardless of
   * DOM order, so without this, .hero-media (positioned) would paint OVER
   * .hero-body/.hero-diagram/the caption (non-positioned) and hide the
   * text — hence every direct content child of .hero below also gets
   * `position: relative` and a z-index above .hero-media's.
   */
  .hero-media {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }

  .hero-media-video,
  .hero-media-poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero-media-poster {
    /* Only shown under reduced motion, below — never a loading placeholder;
       the video's own `poster` attribute already covers that. */
    display: none;
  }

  /*
   * A flat 85%-opacity wash of --bg-invert, not a gradient — deliberately
   * uniform so the worst-case contrast bound holds everywhere in the hero,
   * not just wherever a gradient happens to be darkest. Verified by
   * measuring this specific clip's actual luminance (ffmpeg signalstats:
   * average frame luma never exceeds ~96/255 across the full loop) and
   * computing the pathological case anyway — blending this scrim with a
   * hypothetical PURE WHITE pixel (255,255,255), far brighter than
   * anything in the real footage — still yields an effective background
   * luminance that keeps --text-invert at ~10:1 contrast, comfortably
   * clearing AA (4.5:1) with real margin. Real footage, which never
   * sustains anywhere near pure white over a meaningful area, does
   * better than this bound in practice.
   */
  .hero-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--bg-invert) 85%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-media-video {
      display: none;
    }

    .hero-media-poster {
      display: block;
    }
  }

  /*
   * `.hero-diagram` is :global() deliberately — SectionDiagram is a child
   * component, so its root <figure> only carries SectionDiagram.astro's own
   * scoped data-astro-cid attribute, never index.astro's. A plain (scoped)
   * `.hero-diagram { … }` rule here compiles to
   * `.hero-diagram[data-astro-cid-<index's-hash>]`, which never matches that
   * element — it silently does nothing, and the diagram keeps painting
   * with z-index:auto, i.e. behind .hero-media. Caught by screenshotting
   * the built page directly; computed styles showed position:static on the
   * figure even with this rule present, before the :global() fix.
   */
  .hero > .container {
    position: relative;
    z-index: 1;
  }

  :global(.hero-diagram) {
    position: relative;
    z-index: 1;
  }

  /*
   * Hero load-in: title, then lead, then buttons, then caption, each a
   * beat behind the last — not scroll-driven like .reveal (global.css),
   * because this content is the first thing on the page and is already in
   * the viewport at load; there is no scroll position for a view-timeline
   * to key off yet. This reuses .reveal's own keyframe (`reveal-in` —
   * opacity + a 32px rise + a blur-to-sharp resolve) and its `var(--ease)`
   * curve for the same visual language, just driven by wall-clock time
   * (animation-delay) instead of scroll position. No animation-timeline
   * property is set here, so this carries none of the shorthand-folding
   * risk documented next to `--reveal-timeline` in global.css — that bug is
   * specifically about `animation-timeline` being inlined into the
   * shorthand, and there's no such property in this declaration to inline.
   * Respects prefers-reduced-motion for free, via global.css's existing
   * blanket `animation-duration: 0.01ms !important` override — no separate
   * guard needed here, same as the hero diagram's own load-in animation.
   */
  .hero-title {
    /* Wide enough that the explicit break controls the line turn rather than
       the measure fighting it. */
    max-width: 24ch;
    animation: reveal-in var(--dur-slow) var(--ease) both;
  }

  .hero-lead {
    margin-top: var(--s-5);
    max-width: 58ch;
    font-size: var(--t-md);
    line-height: var(--lh-loose);
    color: var(--text-invert-muted);
    animation: reveal-in var(--dur-slow) var(--ease) 120ms both;
  }

  .hero-actions {
    display: flex;
    gap: var(--s-3);
    margin-top: var(--s-6);
    flex-wrap: wrap;
    animation: reveal-in var(--dur-slow) var(--ease) 240ms both;
  }

  .hero-body {
    padding-bottom: var(--s-7);
  }

  .hero-caption {
    display: flex;
    gap: var(--s-4);
    max-width: 74ch;
    padding-block: var(--s-5) var(--s-8);
    font-size: var(--t-sm);
    line-height: var(--lh-body);
    color: var(--text-invert-muted);
    animation: reveal-in var(--dur-slow) var(--ease) 480ms both;
  }

  .hero-caption-mark {
    flex-shrink: 0;
    width: 28px;
    height: 2px;
    margin-top: 0.7em;
    background: var(--cut-light);
  }

  @media (max-width: 640px) {
    .hero {
      padding-top: var(--s-7);
    }

    .hero-actions .btn {
      flex: 1 1 100%;
    }
  }

  /* ---- Proof strip ---- */
  .proof {
    border-block: var(--border);
  }

  .proof-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin: 0;
  }

  /*
   * A ruled schedule the way a drawing sheet carries one: hairline cells, a
   * tick at each cell head, tabular values. Still a <dl> — the pairing is the
   * meaning and it has to survive being read aloud.
   */
  .proof-item {
    position: relative;
    display: flex;
    flex-direction: column-reverse;
    gap: var(--s-2);
    padding: var(--s-6) var(--s-5);
    border-left: var(--border);
  }

  .proof-item::before {
    content: '';
    position: absolute;
    top: 0;
    left: var(--s-5);
    width: 12px;
    height: 1px;
    background: var(--line-strong);
  }

  .proof-item:first-child {
    border-left: 0;
    padding-left: 0;
  }

  .proof-item:first-child::before {
    left: 0;
  }

  .proof-item dt {
    font-size: var(--t-2xs);
    font-family: var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .proof-item dd {
    margin: 0;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-feature-settings: 'tnum' 1;
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-weight: 500;
    line-height: 1;
  }

  /*
   * Count-up. `--count` is a real, browser-animatable typed <integer>
   * because `@property` registers it (same technique as .site-nav's
   * --logo-scale/--nav-pad in Nav.astro); the `::before`'s
   * `content: counter(stat)` renders whatever `counter-reset: stat
   * var(--count)` currently holds, so the number genuinely ticks up rather
   * than jumping straight to the target. The real, final value ("15+")
   * lives in a `.visually-hidden` sibling for screen readers — a
   * `content: counter()` value mid-animation isn't announced meaningfully,
   * so the animated span is `aria-hidden`.
   *
   * Deliberately NOT `animation-timeline: view()` (unlike .reveal
   * elsewhere in this codebase) — that ties progress directly to scroll
   * offset, which is exactly the "follows the scroll wheel" behaviour this
   * was asked not to have. A scroll-linked timeline also has no concept of
   * "trigger once and finish on its own clock" — scrolling back up
   * un-triggers it. Getting a one-shot, threshold-triggered, plays-to-
   * completion-regardless-of-further-scrolling animation needs to know
   * WHEN a threshold was crossed as a discrete event, which CSS has no
   * primitive for; that part is the small script block below
   * (IntersectionObserver, threshold 0.25, unobserve immediately after the
   * first trigger). The default state here (unguarded) is still the FINAL
   * value with no animation — same "default is correct, animation is a
   * progressive enhancement" shape as everywhere else in this codebase — so
   * the numbers are right immediately even with JS disabled or failed.
   * `.is-counting` (added by the script) is the only thing that starts it.
   */
  @property --count {
    syntax: '<integer>';
    inherits: false;
    initial-value: 0;
  }

  .stat-visual {
    display: inline-flex;
  }

  .stat-count {
    --count: var(--count-target);
    counter-reset: stat var(--count);
  }

  .stat-count::before {
    content: counter(stat);
  }

  .stat-count.is-counting {
    animation: count-up 1.4s var(--ease) forwards;
  }

  @keyframes count-up {
    from {
      --count: 0;
    }
    to {
      --count: var(--count-target);
    }
  }

  @media (max-width: 720px) {
    .proof-grid {
      grid-template-columns: 1fr 1fr;
    }

    .proof-item:nth-child(odd) {
      border-left: 0;
      padding-left: 0;
    }

    .proof-item:nth-child(n + 3) {
      border-top: var(--border);
    }
  }

  /* ---- Section heads ---- */
  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-5);
    margin-bottom: var(--s-4);
    flex-wrap: wrap;
  }

  /* ---- Services ---- */
  .svc-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
    gap: 0;
    list-style: none;
    padding: 0;
  }

  .svc {
    padding: var(--s-6) var(--s-5) var(--s-6) 0;
    border-bottom: var(--border);
  }

  .svc h3 {
    margin-bottom: var(--s-3);
  }

  .svc h3 a {
    text-decoration: none;
  }

  .svc h3 a:hover {
    color: var(--accent-text);
  }

  .svc p {
    font-size: var(--t-sm);
    line-height: var(--lh-body);
    color: var(--text-muted);
    max-width: 42ch;
  }

  /* ---- Position ---- */
  .position {
    display: grid;
    grid-template-columns: 1fr 260px;
    gap: var(--s-8);
    align-items: start;
  }

  .position h2 {
    margin-bottom: var(--s-5);
  }

  .position-link {
    margin-top: var(--s-5);
  }

  .position-aside-title {
    font-size: var(--t-sm);
    font-family: var(--font-mono);
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: var(--s-3);
  }

  .tool-list {
    list-style: none;
    padding: 0;
    display: grid;
  }

  .tool-list li {
    padding-block: var(--s-3);
    border-bottom: var(--border);
    color: var(--text);
    font-size: var(--t-xs);
  }

  @media (max-width: 860px) {
    .position {
      grid-template-columns: 1fr;
      gap: var(--s-6);
    }
  }

  /* ---- Card grids ---- */
  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--s-5);
    margin-top: var(--s-6);
  }
</style>

<script>
  // One-shot count-up trigger for the stat numbers in the proof strip.
  // Deliberately not scroll-linked (see the CSS comment above .stat-count in
  // this file's styles for why) — this fires once, at 25% visible,
  // and the CSS animation it starts runs to completion on its own clock
  // regardless of anything the user does with the scroll wheel afterward.
  const counts = document.querySelectorAll<HTMLElement>('.stat-count');

  if (counts.length && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-counting');
          observer.unobserve(entry.target);
        }
      },
      { threshold: 0.25 }
    );

    for (const el of counts) observer.observe(el);
  }
</script>
